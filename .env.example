# Your Anthropic API key (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Password for the Max web app. Leave empty to skip the login locally.
MAX_PASSWORD=

# Vercel Blob token for online storage. Leave empty to store data in MAX_DATA_DIR.
BLOB_READ_WRITE_TOKEN=

# Where Max keeps data when not using Vercel Blob (defaults to ./data)
MAX_DATA_DIR=./data

# Discord (from https://discord.com/developers/applications → your app)
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Comma-separated Discord user IDs allowed to talk to Max. Leave empty to allow everyone in the server.
DISCORD_ALLOWED_USER_IDS=
